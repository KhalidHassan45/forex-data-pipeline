FROM nginx:1.27-alpine
RUN apk add --no-cache apache2-utils
COPY dashboard/nginx.conf /etc/nginx/conf.d/default.conf
COPY dashboard/entrypoint.sh /docker-entrypoint.d/05-htpasswd.sh
RUN chmod +x /docker-entrypoint.d/05-htpasswd.sh
HEALTHCHECK --interval=60s --timeout=5s CMD wget -qO- http://127.0.0.1/healthz || exit 1
